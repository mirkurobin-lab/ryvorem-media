{%- comment -%} Ryvorem: newsletter pop-up. Native customer form, no app. Opens once after ~6 s or on exit intent (desktop). v25: on ALL product pages (incl. ?view=story ad landing) no 6-s timer: opens after 45 s or once 60 % of the page is read (earliest 15 s), because it interrupted the buying moment. {%- endcomment -%}
{%- if request.design_mode or template.name == 'cart' or customer -%}{%- else -%}
{%- assign rv_landing = false -%}
{%- if template.suffix == 'landing' -%}{%- assign rv_landing = true -%}{%- endif -%}
{%- assign rv_product = false -%}
{%- if template.name == 'product' -%}{%- assign rv_product = true -%}{%- endif -%}
<style>
#rv-nl{padding:0;border:0;background:#F4EBDD;color:#1A1D1F;width:min(440px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow:auto;border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,.28);font-family:inherit}
#rv-nl::backdrop{background:rgba(15,40,42,.55)}
#rv-nl .rv-nl__in{position:relative;padding:32px 26px 24px;text-align:center}
#rv-nl .rv-nl__x{position:absolute;top:8px;right:8px;width:44px;height:44px;border:0;background:transparent;color:#0F5257;font-size:28px;line-height:1;cursor:pointer;border-radius:50%}
#rv-nl .rv-nl__x:hover{background:rgba(15,82,87,.1)}
#rv-nl :focus-visible{outline:3px solid #0F5257;outline-offset:2px}
#rv-nl .rv-nl__logo{display:block;margin:0 auto 14px;height:30px;width:auto}
#rv-nl .rv-nl__brand{display:block;margin:0 0 12px;color:#0F5257;font-weight:700;letter-spacing:.04em}
#rv-nl h2{margin:0 0 8px;color:#0F5257;font-size:clamp(1.45rem,5vw,1.8rem);line-height:1.2}
#rv-nl p{margin:0 0 16px;line-height:1.55;font-size:1rem}
#rv-nl form{display:flex;flex-direction:column;gap:10px;margin:0}
#rv-nl input[type=email]{width:100%;box-sizing:border-box;padding:14px 16px;border-radius:10px;border:1px solid #0F5257;background:#fff;color:#1A1D1F;font-size:16px}
#rv-nl .rv-nl__btn{display:inline-block;box-sizing:border-box;width:100%;padding:14px 20px;border-radius:10px;border:0;background:#0F5257;color:#fff;font-weight:700;font-size:1rem;cursor:pointer;text-align:center;text-decoration:none}
#rv-nl .rv-nl__btn:disabled{opacity:.6;cursor:wait}
#rv-nl .rv-nl__btn--alt{background:transparent;color:#0F5257;border:1px solid #0F5257}
#rv-nl .rv-nl__err{margin:0;color:#8A1C1C;font-size:.9rem}
#rv-nl .rv-nl__fine{margin:12px 0 0;font-size:.8rem;line-height:1.45;color:#3b4a4b}
#rv-nl .rv-nl__code{display:block;margin:6px auto 14px;padding:14px 10px;border:2px dashed #0F5257;border-radius:12px;background:#fff;color:#0F5257;font-size:clamp(1.8rem,8vw,2.4rem);font-weight:800;letter-spacing:.12em}
#rv-nl .rv-nl__row{display:flex;flex-direction:column;gap:10px}
#rv-nl .rv-nl__guide{background:#E9B872;color:#0E2A22;border:0}
#rv-nl .rv-nl__vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
#rv-nl [hidden]{display:none!important}
@media (max-width:749px){
  #rv-nl{width:100%;max-width:100%;margin:auto 0 0;border-radius:20px 20px 0 0;max-height:92vh;animation:rvNlUp .28s ease-out}
  #rv-nl .rv-nl__in{padding:30px 20px calc(20px + env(safe-area-inset-bottom))}
}
@keyframes rvNlUp{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){#rv-nl{animation:none}}
</style>
<dialog id="rv-nl" aria-labelledby="rv-nl-title" aria-describedby="rv-nl-desc" data-landing="{{ rv_landing }}" data-product="{{ rv_product }}">
  <div class="rv-nl__in">
    <button type="button" class="rv-nl__x" data-rv-close aria-label="Close">&times;</button>
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 240 | image_tag: class: 'rv-nl__logo', height: 30, alt: shop.name, loading: 'lazy' }}
    {%- else -%}
      <span class="rv-nl__brand">{{ shop.name }}</span>
    {%- endif -%}
    <div data-rv-view="form">
      <h2 id="rv-nl-title">10% off + a free cat guide</h2>
      <p id="rv-nl-desc">Get 10% off your first order and The Happy Indoor Cat Guide: 15 simple ideas to make your cat's day better. Plus one short cat tip every Thursday.</p>
      {% form 'customer', id: 'rv-popup-form' %}
        {%- if form.posted_successfully? -%}<span data-rv-posted hidden></span>{%- endif -%}
        {%- if form.errors -%}<span data-rv-error hidden></span>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup,free-guide">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <label class="rv-nl__vh" for="rv-nl-email">Email address</label>
        <input id="rv-nl-email" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email" inputmode="email">
        <p class="rv-nl__err" data-rv-err role="alert" hidden>Please enter a valid email address and try again.</p>
        <button type="submit" class="rv-nl__btn" data-rv-submit>Send me both</button>
      {% endform %}
      <p class="rv-nl__fine">By signing up you agree to receive marketing emails from {{ shop.name }}. One use per customer. Unsubscribe anytime.</p>
    </div>
    <div data-rv-view="ok" hidden>
      <h2 id="rv-nl-ok">You are in. Here is your code</h2>
      <span class="rv-nl__code" id="rv-nl-code" aria-label="Your discount code: WELCOME10">WELCOME10</span>
      <div class="rv-nl__row">
        <a class="rv-nl__btn rv-nl__guide" href="https://cdn.shopify.com/s/files/1/1044/6549/8447/files/Ryvorem-Happy-Indoor-Cat-Guide-v2.pdf?v=1791726154" target="_blank" rel="noopener">Open your free guide (PDF)</a>
        <button type="button" class="rv-nl__btn" data-rv-copy>Copy code</button>
        <a class="rv-nl__btn rv-nl__btn--alt" href="/discount/WELCOME10?redirect=%2Fcollections%2Fcat-comfort">Apply code and shop</a>
      </div>
      <p class="rv-nl__fine" role="status" data-rv-live>Use it at checkout on your first order. One use per customer.</p>
    </div>
  </div>
</dialog>
<script>
(function () {
  var d = document.getElementById('rv-nl');
  if (!d || typeof d.showModal !== 'function') return;
  var KD = 'rvNlDismissed', KOK = 'rvNlDone', KS = 'rvNlShown', MS14 = 14 * 24 * 60 * 60 * 1000;
  var landing = d.getAttribute('data-landing') === 'true';
  var product = d.getAttribute('data-product') === 'true';
  function lget(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } }
  function lset(k, v) { try { window.localStorage.setItem(k, v); } catch (e) {} }
  function sget(k) { try { return window.sessionStorage.getItem(k); } catch (e) { return null; } }
  function sset(k, v) { try { window.sessionStorage.setItem(k, v); } catch (e) {} }
  var form = d.querySelector('form');
  var vForm = d.querySelector('[data-rv-view="form"]');
  var vOk = d.querySelector('[data-rv-view="ok"]');
  var errEl = d.querySelector('[data-rv-err]');
  var btn = d.querySelector('[data-rv-submit]');
  var live = d.querySelector('[data-rv-live]');
  var done = lget(KOK) === '1';
  var posted = !!d.querySelector('[data-rv-posted]');
  var lastFocus = null, timer = null, opened = false, busy = false, t0 = Date.now();

  function showOk() {
    vForm.hidden = true; vOk.hidden = false;
    d.setAttribute('aria-labelledby', 'rv-nl-ok');
    d.removeAttribute('aria-describedby');
    lset(KOK, '1');
  }
  function open(isPosted) {
    if (opened || d.open) return;
    if (document.querySelector('dialog[open]')) return;
    opened = true; sset(KS, '1');
    lastFocus = document.activeElement;
    if (isPosted) showOk();
    d.showModal();
    var f = isPosted ? d.querySelector('[data-rv-copy]') : d.querySelector('#rv-nl-email');
    if (f) f.focus();
  }
  d.addEventListener('close', function () {
    if (lget(KOK) !== '1') lset(KD, String(Date.now()));
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
  });
  d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
  d.querySelector('[data-rv-close]').addEventListener('click', function () { d.close(); });

  var copyBtn = d.querySelector('[data-rv-copy]');
  copyBtn.addEventListener('click', function () {
    var code = 'WELCOME10';
    function ok() { copyBtn.textContent = 'Copied'; if (live) live.textContent = 'Code WELCOME10 copied. Use it at checkout.'; }
    function fallback() {
      try {
        var r = document.createRange(); r.selectNodeContents(d.querySelector('#rv-nl-code'));
        var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
        document.execCommand('copy'); s.removeAllRanges(); ok();
      } catch (e) { if (live) live.textContent = 'Select the code and copy it by hand: WELCOME10'; }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(ok, fallback);
    } else { fallback(); }
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (busy) return;
    busy = true; btn.disabled = true; errEl.hidden = true;
    var fd = new FormData(form);
    fetch(form.action, { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function (r) { return r.text(); })
      .then(function (t) {
        var doc = new DOMParser().parseFromString(t, 'text/html');
        var f = doc.getElementById('rv-popup-form');
        if (f && f.querySelector('[data-rv-posted]')) { showOk(); var c = d.querySelector('[data-rv-copy]'); if (c) c.focus(); }
        else if (f && f.querySelector('[data-rv-error]')) { errEl.hidden = false; busy = false; btn.disabled = false; }
        else { form.submit(); }
      })
      .catch(function () { form.submit(); });
  });

  if (posted) { done = true; open(true); return; }
  if (done) return;
  var dis = parseInt(lget(KD) || '0', 10);
  if (dis && Date.now() - dis < MS14) return;
  if (sget(KS) === '1') return;

  var delay = product ? 45000 : (landing ? 12000 : 6000);
  function tryOpen(n) {
    if (opened) return;
    if (document.querySelector('dialog[open]') || document.hidden) {
      if (n < 6) timer = setTimeout(function () { tryOpen(n + 1); }, 4000);
      return;
    }
    open(false);
  }
  timer = setTimeout(function () { tryOpen(0); }, delay);

  if (product) {
    window.addEventListener('scroll', function onScroll() {
      if (opened) { window.removeEventListener('scroll', onScroll); return; }
      var h = document.documentElement;
      if (Date.now() - t0 > 15000 && (window.scrollY + window.innerHeight) / h.scrollHeight > 0.6) {
        window.removeEventListener('scroll', onScroll);
        clearTimeout(timer);
        tryOpen(6);
      }
    }, { passive: true });
  }

  var minExit = landing ? 10000 : (product ? 15000 : 3000);
  if (window.matchMedia && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
    document.addEventListener('mouseout', function onOut(e) {
      if (opened) { document.removeEventListener('mouseout', onOut); return; }
      if (e.relatedTarget || e.clientY > 0) return;
      if (Date.now() - t0 < minExit) return;
      document.removeEventListener('mouseout', onOut);
      clearTimeout(timer);
      tryOpen(6);
    });
  }
})();
</script>
{%- endif -%}
